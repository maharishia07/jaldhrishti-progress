# Copy this file to .env and fill in real values. Never commit the real .env file.

# Telegram bot token — get from @BotFather on Telegram
BOT_TOKEN=

# Gemini API key — get free at https://aistudio.google.com
GEMINI_API_KEY=

# Optional SQLite path. Leave blank for data/output/jaldhrishti.db on fresh installs.
# Existing scheduler/jaldhrishti.db is reused if present. Relative overrides
# are relative to the process working directory, matching legacy behavior.
JALDHRISHTI_DB=
